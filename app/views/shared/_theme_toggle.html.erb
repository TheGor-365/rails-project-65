<button type="button"
        class="cl-theme-toggle"
        data-controller="theme"
        data-action="click->theme#toggle"
        data-theme-target="button"
        data-theme-enable-dark-label-value="<%= t('shared.theme.enable_dark') %>"
        data-theme-enable-light-label-value="<%= t('shared.theme.enable_light') %>"
        aria-label="<%= t('shared.theme.enable_dark') %>"
        aria-pressed="false"
        title="<%= t('shared.theme.enable_dark') %>">
  <i class="bi bi-moon-fill" data-theme-target="icon" aria-hidden="true"></i>
</button>
