<% if flash.any? %>
  <div class="container-xl cl-flash-messages" aria-live="polite">
    <% flash.each do |type, message| %>
      <% level = case type.to_s
                 when 'notice' then 'success'
                 when 'alert' then 'danger'
                 else 'info'
                 end %>
      <div class="alert alert-<%= level %> mt-3 mb-0" role="alert"><%= message %></div>
    <% end %>
  </div>
<% end %>
