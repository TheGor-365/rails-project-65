<% content_for :title, t('pages.conversations.show.page_title') %>
<nav class="cl-detail-breadcrumb" aria-label="<%= t('pages.conversations.show.breadcrumb_label') %>">
  <%= link_to conversations_path do %><i class="bi bi-arrow-left" aria-hidden="true"></i> <%= t('pages.conversations.show.all_conversations') %><% end %>
</nav>

<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow"><%= t('pages.conversations.show.eyebrow') %></p>
    <h2><%= @conversation.bulletin.title %></h2>
    <p class="cl-management-lead">
      <%= @conversation.buyer_id == current_user.id ? t('pages.conversations.shared.author') : t('pages.conversations.shared.buyer') %>:
      <%= @conversation.other_participant(current_user).name.presence || t('pages.conversations.shared.user') %>
    </p>
  </div>
  <% if @conversation.bulletin.published? || @conversation.bulletin.user_id == current_user.id %>
    <%= link_to t('pages.conversations.show.listing'), bulletin_path(@conversation.bulletin), class: 'btn btn-outline-secondary' %>
  <% end %>
</div>

<section class="cl-message-thread" aria-label="<%= t('pages.conversations.show.thread_label') %>">
  <% @messages.each do |message| %>
    <article class="cl-message-bubble <%= 'cl-message-bubble--mine' if message.sender_id == current_user.id %>">
      <div class="cl-message-bubble__meta">
        <strong><%= message.sender_id == current_user.id ? t('pages.conversations.show.you') : (message.sender.name.presence || t('pages.conversations.show.other_participant')) %></strong>
        <time datetime="<%= message.created_at.iso8601 %>"><%= l(message.created_at, format: :conversation) %></time>
      </div>
      <div class="cl-message-bubble__body"><%= message.body %></div>
    </article>
  <% end %>
</section>
<div class="mt-3 mb-4"><%= paginate @messages %></div>

<section class="cl-management-panel cl-message-compose" aria-label="<%= t('pages.conversations.show.reply_form_label') %>">
  <h3 class="h5 mb-3"><%= t('pages.conversations.show.reply_heading') %></h3>
  <%= form_with model: @message, url: conversation_messages_path(@conversation), local: true do |f| %>
    <%= render 'web/conversations/message_fields', form: f, message: @message %>
    <%= f.submit t('pages.conversations.show.reply_submit'), class: 'btn btn-primary' %>
  <% end %>
</section>
