<% if message.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <strong>Сообщение не отправлено.</strong>
    <ul class="mb-0 mt-2">
      <% message.errors.full_messages.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form.label :body, 'Текст сообщения', class: 'form-label fw-semibold' %>
<%= form.text_area :body, class: 'form-control cl-message-input', rows: 5, maxlength: 2000,
      required: true, placeholder: 'Задайте вопрос по объявлению. Не отправляйте пароли и платёжные данные.' %>
<p class="form-text">До 2000 символов. Сообщение увидит только второй участник диалога.</p>
