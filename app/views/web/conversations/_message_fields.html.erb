<% if message.errors.any? %>
  <div class="alert alert-danger" role="alert">
    <strong><%= t('pages.conversations.message_fields.not_sent') %></strong>
    <ul class="mb-0 mt-2">
      <% message.errors.full_messages.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form.label :body, t('pages.conversations.message_fields.body_label'), class: 'form-label fw-semibold' %>
<%= form.text_area :body, class: 'form-control cl-message-input', rows: 5, maxlength: 2000,
      required: true, placeholder: t('pages.conversations.message_fields.body_placeholder') %>
<p class="form-text"><%= t('pages.conversations.message_fields.body_hint') %></p>
