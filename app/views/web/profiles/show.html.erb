<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow">Личный кабинет</p>
    <h2>Мои объявления</h2>
    <p class="cl-management-lead">Следите за публикациями, отправляйте черновики на проверку и управляйте архивом.</p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to favorites_path, class: 'btn btn-outline-secondary cl-management-create' do %>
      <i class="bi bi-heart" aria-hidden="true"></i> Избранное
    <% end %>
  <%= link_to new_bulletin_path, class: 'btn btn-primary cl-management-create' do %>
    <i class="bi bi-plus-lg" aria-hidden="true"></i> Создать объявление
  <% end %>
  </div>
</div>

<div class="cl-metrics" aria-label="Сводка моих объявлений">
  <div class="cl-metric"><span>Всего объявлений</span><strong><%= @state_counts.values.sum %></strong></div>
  <div class="cl-metric"><span>Опубликовано</span><strong><%= @state_counts.fetch('published', 0) %></strong></div>
  <div class="cl-metric"><span>На модерации</span><strong><%= @state_counts.fetch('under_moderation', 0) %></strong></div>
</div>

<section class="cl-management-panel" aria-label="Фильтры моих объявлений">
  <%= search_form_for @q, url: profile_path, method: :get do |f| %>
    <div class="cl-management-filters">
      <%= f.search_field :title_cont, class: 'form-control', placeholder: 'Поиск по названию',
            aria: { label: 'Название объявления' } %>
      <%= f.select :category_id_eq,
            options_from_collection_for_select(@categories, :id, :name, @q.category_id_eq),
            { include_blank: 'Все категории' }, class: 'form-select', aria: { label: 'Категория' } %>
      <%= f.select :state_eq, bulletin_state_options,
            { include_blank: 'Все статусы' }, class: 'form-select', aria: { label: 'Статус' } %>
      <%= f.submit 'Найти', class: 'btn btn-primary' %>
      <%= link_to 'Сброс', profile_path, class: 'btn btn-outline-secondary' %>
    </div>
  <% end %>
</section>

<section class="cl-management-panel cl-management-panel--table" aria-label="Список моих объявлений">
  <div class="cl-management-panel__heading">
    <h3>Мои публикации</h3>
    <span class="cl-management-panel__hint"><%= @bulletins.total_count %> в текущей выборке</span>
  </div>
  <% if @bulletins.any? %>
    <div class="table-responsive">
      <table class="table cl-management-table align-middle">
        <thead><tr>
          <th scope="col">Объявление</th>
          <th scope="col">Категория</th>
          <th scope="col">Статус</th>
          <th scope="col" class="text-end">Действия</th>
        </tr></thead>
        <tbody>
          <% @bulletins.each do |b| %>
            <tr>
              <td>
                <%= link_to b.title, bulletin_path(b), class: 'cl-management-link' %>
                <div class="cl-management-row-meta">Добавлено <%= b.created_at.strftime('%d.%m.%Y') %></div>
              </td>
              <td><%= b.category.name %></td>
              <td><%= render 'shared/bulletin_status', bulletin: b %></td>
              <td>
                <div class="cl-row-actions">
                  <%= link_to 'Редактировать', edit_bulletin_path(b),
                        class: 'btn btn-sm btn-outline-secondary' %>
                  <% if b.may_to_moderate? %>
                    <%= button_to 'На модерацию', to_moderate_bulletin_path(b),
                          method: :patch, class: 'btn btn-sm btn-outline-primary',
                          data: { turbo_confirm: 'Отправить объявление на модерацию?' } %>
                  <% end %>
                  <% if b.may_archive? %>
                    <%= button_to 'В архив', archive_bulletin_path(b),
                          method: :patch, class: 'btn btn-sm btn-outline-secondary',
                          data: { turbo_confirm: 'Отправить в архив?' } %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="cl-management-empty">
      <i class="bi bi-inbox" aria-hidden="true"></i>
      <h4>Объявлений по этим условиям нет</h4>
      <p>Измените фильтры или создайте новое объявление.</p>
      <%= link_to 'Сбросить фильтры', profile_path, class: 'btn btn-outline-primary' %>
    </div>
  <% end %>
</section>

<div class="mt-3"><%= paginate @bulletins, params: request.query_parameters %></div>
