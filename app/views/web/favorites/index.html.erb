<% content_for :title, t('pages.favorites.index.page_title') %>
<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow"><%= t('pages.favorites.index.eyebrow') %></p>
    <h2><%= t('pages.favorites.index.heading') %></h2>
    <p class="cl-management-lead"><%= t('pages.favorites.index.explanation') %></p>
  </div>
  <%= link_to t('pages.favorites.index.back_to_profile'), profile_path, class: 'btn btn-outline-secondary' %>
</div>

<% if @favorites.any? %>
  <p class="cl-muted mb-3"><%= t('pages.favorites.index.saved_count', count: @favorites.total_count) %></p>
  <div class="cl-catalog-grid">
    <% @favorites.each do |favorite| %>
      <%= render 'web/bulletins/bulletin_card', bulletin: favorite.bulletin %>
    <% end %>
  </div>
  <div class="mt-4"><%= paginate @favorites %></div>
<% else %>
  <section class="cl-empty-state" role="status">
    <i class="bi bi-heart" aria-hidden="true"></i>
    <h3><%= t('pages.favorites.index.empty_heading') %></h3>
    <p><%= t('pages.favorites.index.empty_help') %></p>
    <%= link_to t('pages.favorites.index.browse_catalog'), root_path, class: 'btn btn-primary' %>
  </section>
<% end %>
