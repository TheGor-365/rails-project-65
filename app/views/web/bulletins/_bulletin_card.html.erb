<article class="cl-listing-card">
  <%= link_to bulletin_path(bulletin), class: 'cl-listing-card__media', aria: { label: t('pages.bulletins.card.open_listing', title: bulletin.title) } do %>
    <% if bulletin.image.attached? %>
      <% first_image = local_assigns.fetch(:bulletin_counter, 1).zero? %>
      <%= image_tag bulletin.image, class: 'cl-listing-card__image', alt: bulletin.title,
            loading: (first_image ? 'eager' : 'lazy'), fetchpriority: (first_image ? 'high' : nil),
            decoding: 'async', width: 720, height: 540 %>
    <% else %>
      <span class="cl-listing-card__placeholder"><i class="bi bi-image" aria-hidden="true"></i><%= t('pages.bulletins.card.no_photo') %></span>
    <% end %>
  <% end %>
  <div class="cl-listing-card__body">
    <span class="cl-listing-card__category"><i class="bi bi-tag" aria-hidden="true"></i> <%= localized_category_name(bulletin.category) %></span>
    <h3 class="cl-listing-card__title"><%= link_to bulletin.title, bulletin_path(bulletin) %></h3>
    <p class="cl-listing-card__description"><%= truncate(public_bulletin_description(bulletin.description), length: 150) %></p>
    <div class="cl-listing-card__meta">
      <i class="bi bi-calendar3" aria-hidden="true"></i>
      <%= t('pages.bulletins.card.added', date: l(bulletin.created_at.to_date, format: :short)) %>
    </div>
  </div>
</article>
