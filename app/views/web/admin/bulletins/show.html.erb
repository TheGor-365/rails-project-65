<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0"><%= @bulletin.title %></h2>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to "Редактировать",
        edit_admin_bulletin_path(@bulletin),
        class: "btn btn-primary" %>
    <%= link_to "К объявлениям",
        admin_bulletins_path,
        class: "btn btn-outline-secondary" %>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <p>
      <strong>Категория:</strong> <%= @bulletin.category.name %>
    </p>
    <p>
      <strong>Автор:</strong> <%= @bulletin.user&.name || "Не указан" %>
    </p>
    <p>
      <strong>Статус:</strong>
      <span class="badge text-bg-secondary"><%= @bulletin.state %></span>
    </p>

    <% if @bulletin.image.attached? %>
      <div class="mb-3">
        <%= image_tag @bulletin.image,
            class: "img-fluid rounded",
            alt: @bulletin.title,
            style: "max-height: 28rem; object-fit: contain;" %>
      </div>
    <% end %>

    <h5>Описание</h5>
    <%= simple_format(@bulletin.description) %>
  </div>
</div>
