<% content_for :title, t('pages.admin.bulletins.show.page_title') %>
<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow"><%= t('pages.admin.bulletins.show.eyebrow') %></p>
    <h2><%= @bulletin.title %></h2>
    <p class="cl-management-lead"><%= t('pages.admin.bulletins.show.lead') %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <%= link_to t('pages.admin.bulletins.show.edit_action'), edit_admin_bulletin_path(@bulletin), class: 'btn btn-primary' %>
    <%= link_to t('pages.admin.bulletins.show.back_action'), admin_bulletins_path, class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="cl-management-panel">
  <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <%= render 'shared/bulletin_status', bulletin: @bulletin %>
    <span class="cl-management-panel__hint"><%= t('pages.admin.bulletins.show.category', name: localized_category_name(@bulletin.category)) %></span>
    <span class="cl-management-panel__hint"><%= t('pages.admin.bulletins.show.author', name: (@bulletin.user&.name || @bulletin.user&.email || t('pages.admin.bulletins.show.not_specified'))) %></span>
  </div>

  <% if @bulletin.image.attached? %>
    <%= image_tag @bulletin.image, alt: @bulletin.title, class: 'cl-admin-preview-image mb-4' %>
  <% end %>

  <h3 class="h5"><%= t('pages.admin.bulletins.show.description_heading') %></h3>
  <div class="cl-detail-description__text"><%= simple_format(@bulletin.description) %></div>
</div>
