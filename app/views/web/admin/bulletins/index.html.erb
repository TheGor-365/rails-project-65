<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow">Панель управления</p>
    <h2>Модерация объявлений</h2>
    <p class="cl-management-lead">Проверяйте заявки и управляйте публикациями, не покидая рабочий список.</p>
  </div>
  <%= link_to admin_categories_path, class: 'btn btn-outline-secondary' do %>
    <i class="bi bi-tags" aria-hidden="true"></i> Категории
  <% end %>
</div>

<div class="cl-metrics" aria-label="Сводка модерации">
  <div class="cl-metric"><span>Всего объявлений</span><strong><%= @state_counts.values.sum %></strong></div>
  <div class="cl-metric"><span>Ожидают проверки</span><strong><%= @state_counts.fetch('under_moderation', 0) %></strong></div>
  <div class="cl-metric"><span>Опубликовано</span><strong><%= @state_counts.fetch('published', 0) %></strong></div>
</div>

<section class="cl-management-panel" aria-label="Фильтры модерации">
  <%= search_form_for @q, url: admin_bulletins_path, method: :get do |f| %>
    <div class="cl-management-filters cl-management-filters--admin">
      <%= f.search_field :title_cont, class: 'form-control', placeholder: 'Название объявления',
            aria: { label: 'Название объявления' } %>
      <%= f.select :category_id_eq,
            options_from_collection_for_select(@categories, :id, :name, @q.category_id_eq),
            { include_blank: 'Все категории' }, class: 'form-select', aria: { label: 'Категория' } %>
      <%= f.select :state_eq, bulletin_state_options,
            { include_blank: 'Все статусы' }, class: 'form-select', aria: { label: 'Статус' } %>
      <%= f.search_field :user_email_cont, class: 'form-control',
            placeholder: 'Email автора', aria: { label: 'Email автора' } %>
      <%= f.submit 'Найти', class: 'btn btn-primary' %>
      <%= link_to 'Сброс', admin_bulletins_path, class: 'btn btn-outline-secondary' %>
    </div>
  <% end %>
</section>

<section class="cl-management-panel cl-management-panel--table" aria-label="Результаты модерации">
  <div class="cl-management-panel__heading">
    <h3>Очередь объявлений</h3>
    <span class="cl-management-panel__hint"><%= @bulletins.total_count %> в текущей выборке</span>
  </div>
  <% if @bulletins.any? %>
    <div class="table-responsive">
      <table class="table cl-management-table align-middle">
        <thead><tr>
          <th scope="col">Объявление</th>
          <th scope="col">Категория</th>
          <th scope="col">Автор</th>
          <th scope="col">Статус</th>
          <th scope="col" class="text-end">Действия</th>
        </tr></thead>
        <tbody>
          <% @bulletins.each do |b| %>
            <tr>
              <td>
                <%= link_to b.title, admin_bulletin_path(b), class: 'cl-management-link' %>
                <div class="cl-management-row-meta">Добавлено <%= b.created_at.strftime('%d.%m.%Y') %></div>
              </td>
              <td><%= b.category.name %></td>
              <td><%= b.user&.email || b.user&.name %></td>
              <td><%= render 'shared/bulletin_status', bulletin: b %></td>
              <td>
                <div class="cl-row-actions">
                  <% if b.may_publish? %>
                    <%= button_to 'Опубликовать', publish_admin_bulletin_path(b),
                          method: :patch, class: 'btn btn-sm btn-success' %>
                  <% end %>
                  <% if b.may_reject? %>
                    <%= button_to 'Отклонить', reject_admin_bulletin_path(b),
                          method: :patch, class: 'btn btn-sm btn-outline-warning' %>
                  <% end %>
                  <% if b.may_archive? %>
                    <%= button_to 'В архив', archive_admin_bulletin_path(b),
                          method: :patch, class: 'btn btn-sm btn-outline-secondary' %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="cl-management-empty">
      <i class="bi bi-check2-circle" aria-hidden="true"></i>
      <h4>По заданным фильтрам объявлений нет</h4>
      <p>Попробуйте другую категорию или статус.</p>
      <%= link_to 'Очистить фильтры', admin_bulletins_path, class: 'btn btn-outline-primary' %>
    </div>
  <% end %>
</section>

<div class="mt-3"><%= paginate @bulletins, params: request.query_parameters %></div>
