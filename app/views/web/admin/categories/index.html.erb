<div class="cl-management-heading">
  <div>
    <p class="cl-eyebrow">Панель управления</p>
    <h2>Категории</h2>
    <p class="cl-management-lead">Управляйте разделами каталога и их названиями.</p>
  </div>
  <%= link_to 'К модерации', admin_bulletins_path, class: 'btn btn-outline-secondary' %>
</div>

<div class="row g-3">
  <div class="col-12 col-lg-5">
    <section class="cl-management-panel h-100" aria-label="Создание категории">
      <h3 class="h5 mb-3">Новая категория</h3>
      <p class="cl-management-panel__hint mb-3">Название будет доступно при поиске и создании объявлений.</p>
      <%= render 'form', category: @category, submit_label: 'Создать категорию' %>
    </section>
  </div>

  <div class="col-12 col-lg-7">
    <section class="cl-management-panel h-100" aria-label="Список категорий">
      <div class="cl-management-panel__heading px-0 pt-0">
        <h3>Разделы каталога</h3>
        <span class="cl-management-panel__hint"><%= @categories.size %> всего</span>
      </div>
      <% if @categories.any? %>
        <ul class="list-group cl-management-list mt-3">
          <% @categories.each do |category| %>
            <li class="list-group-item cl-management-list-item">
              <span class="cl-management-link"><i class="bi bi-tag me-2" aria-hidden="true"></i><%= category.name %></span>
              <span class="d-flex flex-wrap gap-2">
                <%= link_to 'Редактировать', edit_admin_category_path(category),
                      class: 'btn btn-sm btn-outline-secondary' %>
                <%= link_to 'Удалить', admin_category_path(category),
                      data: { turbo_method: :delete, turbo_confirm: 'Удалить категорию?' },
                      class: 'btn btn-sm btn-outline-danger' %>
              </span>
            </li>
          <% end %>
        </ul>
      <% else %>
        <div class="cl-management-empty">
          <i class="bi bi-tags" aria-hidden="true"></i>
          <h4>Категории пока не созданы</h4>
          <p>Добавьте первую категорию в форме слева.</p>
        </div>
      <% end %>
    </section>
  </div>
</div>
