<%= form_with model: category, url: [:admin, category], local: true, class: 'cl-management-form' do |f| %>
  <% if category.errors.any? %>
    <div class="alert alert-danger" role="alert"><%= category.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="mb-3">
    <%= f.label :name, t('pages.admin.categories.form.name_label'), class: 'form-label' %>
    <%= f.text_field :name, class: 'form-control', required: true, placeholder: t('pages.admin.categories.form.name_placeholder') %>
  </div>
  <%= f.submit local_assigns.fetch(:submit_label, t('pages.admin.categories.form.save')), class: 'btn btn-primary' %>
<% end %>
