<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "Classifieds · Объявления" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Install the selected Bootstrap color mode before styles are painted. %>
    <%= javascript_tag nonce: true do %>
      (function () {
        var mode;
        try {
          mode = window.localStorage.getItem('classifieds:theme');
        } catch (_) {
          mode = null;
        }
        if (mode !== 'light' && mode !== 'dark') {
          mode = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-bs-theme', mode);
      }());
    <% end %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <link rel="icon" href="/favicon.ico?v=2" sizes="any">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="d-flex flex-column min-vh-100">
    <%= render 'shared/app_header' %>
    <%= render 'shared/flash' %>

    <main id="main-content" class="flex-grow-1">
      <div class="container-xl py-4">
        <%= yield %>
      </div>
    </main>

    <%= render 'shared/app_footer' %>
  </body>
</html>
